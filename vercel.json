{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "reines-boutique.vercel.app" }],
      "destination": "https://www.lesreinesboutique.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/boutique/produit.html",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(WhatsApp|facebookexternalhit|Facebot|meta-externalagent|TelegramBot|Twitterbot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview|Pinterest|redditbot|vkShare|Viber|SnapchatAds).*" }],
      "destination": "/api/apercu?type=produit"
    },
    {
      "source": "/boutique/vendeuse.html",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(WhatsApp|facebookexternalhit|Facebot|meta-externalagent|TelegramBot|Twitterbot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview|Pinterest|redditbot|vkShare|Viber|SnapchatAds).*" }],
      "destination": "/api/apercu?type=boutique"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ]
}
